{
    "openapi": "3.1.0",
    "info": {
        "title": "humanOS API",
        "version": "1.0.0",
        "description": "Backend API for humanOS: nutrition, workouts, health metrics, goals and recommendations."
    },
    "servers": [
        {
            "url": "api",
            "description": "Local"
        }
    ],
    "tags": [
        {
            "name": "Auth"
        }
    ],
    "security": [
        {
            "http": []
        }
    ],
    "paths": {
        "/v1/auth/register": {
            "post": {
                "operationId": "auth.register",
                "description": "Creates the account, sends the email verification link and issues the first\npersonal access token. The token is named after `device_name`, or the User-Agent\nwhen it is missing.",
                "summary": "Register a new user",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "`AuthTokenResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/AuthTokenResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/v1/auth/login": {
            "post": {
                "operationId": "login.login",
                "description": "Checks the credentials and issues a new personal access token. Wrong credentials\nreturn a validation error on `email`. Limited to 5 attempts per minute per email and IP.",
                "summary": "Log in",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`AuthTokenResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/AuthTokenResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/v1/auth/forgot-password": {
            "post": {
                "operationId": "passwordReset.forgot",
                "description": "Emails a password reset link. The response is the same whether the email is\nregistered or not, so it cannot be used to discover accounts.",
                "summary": "Request a password reset link",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ForgotPasswordRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "const": "If that email is registered, a password reset link has been sent."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/v1/auth/reset-password": {
            "post": {
                "operationId": "passwordReset.reset",
                "description": "Sets a new password using the token from the reset email, and revokes every\npersonal access token of the user.",
                "summary": "Reset the password",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ResetPasswordRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/v1/auth/email/verify/{id}/{hash}": {
            "get": {
                "operationId": "auth.verification.verify",
                "description": "Marks the email as verified. This is the link sent by email: it is authenticated by\nits signature (`expires` and `signature` query parameters), not by a token. Verifying\nan already verified email succeeds.",
                "summary": "Verify email",
                "tags": [
                    "Auth"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "hash",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "An error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview.",
                                            "examples": [
                                                "Invalid verification link."
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/v1/auth/logout": {
            "post": {
                "operationId": "login.logout",
                "description": "Revokes the token used for this request. Other tokens of the user stay valid.",
                "summary": "Log out",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/auth/me": {
            "get": {
                "operationId": "auth.me",
                "description": "Returns the user the bearer token belongs to.",
                "summary": "Get the current user",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/UserResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/auth/email/verification-notification": {
            "post": {
                "operationId": "emailVerification.resend",
                "description": "Sends a new verification link to the current user. Returns 202 when the email is\nsent, and 200 when the email is already verified.",
                "summary": "Resend the verification email",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "202": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "const": "Verification link sent."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "const": "Email already verified."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/auth/tokens": {
            "get": {
                "operationId": "token.index",
                "description": "Lists the user's personal access tokens, newest first. Token values are never returned.",
                "summary": "List tokens",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "200": {
                        "description": "Array of `TokenResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/TokenResource"
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            },
            "delete": {
                "operationId": "token.destroyAll",
                "description": "Deletes every token of the user, including the one used for this request.",
                "summary": "Revoke all tokens",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/auth/tokens/{id}": {
            "delete": {
                "operationId": "token.destroy",
                "description": "Deletes one of the user's tokens. A token that does not exist or belongs to another\nuser returns 404.",
                "summary": "Revoke a token",
                "tags": [
                    "Auth"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "http": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "AuthTokenResource": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string",
                        "examples": [
                            "1|xR8nQ2vLk9Tz4WmP7bYc3HdF6gJs1NaE5uVo0iKq6b79c89d"
                        ]
                    },
                    "user": {
                        "$ref": "#/components/schemas/UserResource"
                    }
                },
                "required": [
                    "token",
                    "user"
                ],
                "title": "AuthTokenResource"
            },
            "ForgotPasswordRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "examples": [
                            "ana@example.com"
                        ]
                    }
                },
                "required": [
                    "email"
                ],
                "title": "ForgotPasswordRequest"
            },
            "LoginRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "examples": [
                            "ana@example.com"
                        ]
                    },
                    "password": {
                        "type": "string",
                        "examples": [
                            "correct-horse-battery-staple"
                        ]
                    },
                    "device_name": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "examples": [
                            "iPhone 15"
                        ],
                        "maxLength": 255
                    }
                },
                "required": [
                    "email",
                    "password"
                ],
                "title": "LoginRequest"
            },
            "RegisterRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "examples": [
                            "Ana Torres"
                        ],
                        "maxLength": 255
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "examples": [
                            "ana@example.com"
                        ],
                        "maxLength": 255
                    },
                    "password": {
                        "type": "string",
                        "examples": [
                            "correct-horse-battery-staple"
                        ]
                    },
                    "device_name": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "examples": [
                            "iPhone 15"
                        ],
                        "maxLength": 255
                    },
                    "password_confirmation": {
                        "type": "string",
                        "examples": [
                            "correct-horse-battery-staple"
                        ]
                    }
                },
                "required": [
                    "name",
                    "email",
                    "password",
                    "password_confirmation"
                ],
                "title": "RegisterRequest"
            },
            "ResetPasswordRequest": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string",
                        "examples": [
                            "8f14e45fceea167a5a36dedd4bea2543a7c6f5b1e2d3c4b5a6978899aabbccdd"
                        ]
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "examples": [
                            "ana@example.com"
                        ]
                    },
                    "password": {
                        "type": "string",
                        "examples": [
                            "new-correct-horse-battery-staple"
                        ]
                    },
                    "password_confirmation": {
                        "type": "string",
                        "examples": [
                            "new-correct-horse-battery-staple"
                        ]
                    }
                },
                "required": [
                    "token",
                    "email",
                    "password",
                    "password_confirmation"
                ],
                "title": "ResetPasswordRequest"
            },
            "TokenResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "examples": [
                            1
                        ]
                    },
                    "name": {
                        "type": "string",
                        "examples": [
                            "iPhone 15"
                        ]
                    },
                    "last_used_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "examples": [
                            "2026-10-11T10:15:00Z"
                        ]
                    },
                    "created_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "examples": [
                            "2026-10-11T09:30:00Z"
                        ]
                    },
                    "expires_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "examples": [
                            "2026-11-10T09:30:00Z"
                        ]
                    },
                    "is_current": {
                        "type": "boolean",
                        "examples": [
                            true
                        ]
                    }
                },
                "required": [
                    "id",
                    "name",
                    "last_used_at",
                    "created_at",
                    "expires_at",
                    "is_current"
                ],
                "title": "TokenResource"
            },
            "UserResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "examples": [
                            1
                        ]
                    },
                    "name": {
                        "type": "string",
                        "examples": [
                            "Ana Torres"
                        ]
                    },
                    "email": {
                        "type": "string",
                        "examples": [
                            "ana@example.com"
                        ]
                    },
                    "role": {
                        "type": "string",
                        "examples": [
                            "user"
                        ]
                    },
                    "email_verified_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "examples": [
                            "2026-10-11T09:35:00Z"
                        ]
                    },
                    "created_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "examples": [
                            "2026-10-11T09:30:00Z"
                        ]
                    }
                },
                "required": [
                    "id",
                    "name",
                    "email",
                    "role",
                    "email_verified_at",
                    "created_at"
                ],
                "title": "UserResource"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "ModelNotFoundException": {
                "description": "Not found",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}